{
  "name": "@derschmale/tiny-helix",
  "version": "0.1.0",
  "description": "A TypeScript library for WebGPU",
  "main": "dist/tiny-helix.js",
  "module": "dist/tiny-helix.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "webpack --config webpack.config.cjs",
    "build:debug": "webpack --config webpack.config.cjs",
    "docs": "npx typedoc --out docs src",
