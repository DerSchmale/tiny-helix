    "graphics",
    "3d"
  ],
  "author": "David Lenaerts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerSchmale/tiny-helix.git"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@webgpu/types": "^0.1.66",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "typedoc": "^0.25.0"
  },
  "peerDependencies": {
    "@webgpu/types": ">=0.1.0"
  },
